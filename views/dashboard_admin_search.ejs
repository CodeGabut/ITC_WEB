<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dasbor Admin - UKM ITC MIPA UNSOED</title>
    <link rel="icon" type="png" href="/images/favicon.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="/css/style.css" rel="stylesheet" />
    <link href="/css/dashboard_admin.css" rel="stylesheet" />
    <link href="/css/dasbor.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    
  </head>

  
  <body>

      <div class="body-container">
        <div class="navbar-container" id="sidebar">
            <div class="nav-icon">
                <a href="#"><span class="material-symbols-rounded font-black">home</span></a>
                <a id="closeBtn"><span class="material-symbols-rounded font-black close-btn">close</span></a>
            </div>
            <div class="nav-button">
                <div class="on-page-button nav-list"><a>Data-data Artikel</a></div>
                <div class="nav-list"><a>Link Shorterner</a></div>
                <div class="nav-list"><a>Lorem Ipsum 3</a></div>
                <div class="nav-list"><a>Lorem Ipsum 4</a></div>
                <div class="nav-list"><a>Lorem Ipsum 5</a></div>
            </div>
        </div>
        <div class="main-container" id="main">
            <div class="nav-main">
                <span class="material-symbols-rounded nav-main-item menu-btn" id="menuBtn">menu</span>
                <h1 class="nav-title nav-main-item">Data-Data Artikel</h1>
            </div>

        </div>
           
      </div>

  
<section class="container " >
    <h4 class="font-judul">DATA-DATA ARTIKEL</h4>
  <p class="font-judul">Ini merupakan data-data artikel untuk menambah,menghapus, ataupun mengedit artike-artikelnya</p>


   <form  method="get"  action="/dashboard_admin/search">
    <input type="text" name="find" placeholder="Cari artikel..."> <button>Cari</button>
    </form>


    <table class="table m-0" >
    <thead>
    <tr>
      
      <th scope="col" class="coloumn_isi">Title</th>
      <th scope="col" class="coloumn_isi">Date</th>
      <th scope="col"class="coloumn_isi">Status</th>
      
        <th scope="col"class="coloumn_isi">

          <a href="/create_article" style="color: inherit; text-decoration: none;">

            <i class="bi bi-plus-circle-fill" style="font-size: 24px;"></i>

          </a>
        
        </th>
      
    </tr>
    </thead>
    <tbody >

      <% data_article.forEach((element,index) => { %>
        <tr>
      
      <td class="isi"><%- element.title %></td>
      <td class="isi"><%- element.date.toLocaleDateString("id-ID", {
  day: 'numeric',
  month: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false 
})%></td>
      <td class="isi"><%- element.isPublished ? 'Publish' : 'Hiden' %></td>
       <td class="isi"><div class="dropdown">
  <a  href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="bi bi-gear-fill" style="color: rgb(126, 125, 125);"></i>
  </a>
  <ul class="dropdown-menu">
    <li><a class="dropdown-item" target="_blank" href="article/<%-element.slug%>"><i class="bi bi-link " style="margin-right: 5px !important;"></i>Visit</a></li>
    <li><a class="dropdown-item" href="/details_article/<%-element.slug%>"><i class="bi bi-file-code " style="margin-right: 5px !important;"></i>Details</a></li>
    <li><a class="dropdown-item" href="/edit/<%-element.slug%>"><i class="bi bi-pencil " style="margin-right: 5px !important;"></i>Edit</a></li>
    <li>
  <a class="dropdown-item" href="/hiden/<%= element.slug %>">
    <%- !element.isPublished ? '<i class="bi bi-eye" style="margin-right: 5px !important;"></i> Publish': '<i class="bi bi-eye-slash" style="margin-right: 5px !important;"></i> Hide' %>
  </a></li>

    <li>
  <form action="/delete_article/<%- element.slug %>" method="POST" style="display:inline;">
    <button type="submit" class="dropdown-item">
      <i class="bi bi-trash" style="margin-right: 5px !important;"></i>Delete
    </button>
   
  </form>
</li>
  </ul>
</div>

</td>
    </tr>
      <% }) %>
    </div>
    
  </tbody>
</table>
<div class="footer_table">
  Found : <%- total  %>
</div>

</section>


<script>
    const menuBtn = document.getElementById("menuBtn");
    const closeBtn = document.getElementById("closeBtn");
    const sidebar = document.getElementById("sidebar");
    const main = document.getElementById("main");

    menuBtn.addEventListener("click", () => {
      sidebar.classList.add("active");
      menuBtn.classList.add("hide");
    });

    closeBtn.addEventListener("click", () => {
      sidebar.classList.remove("active");
      menuBtn.classList.remove("hide");
    });
    </script>


<script src="js/delete_method.js" >
</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
  </body>
</html>