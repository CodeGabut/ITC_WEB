<section class="container data_details" >
  <h4 >DETAILS ARTICLE</h4>
  <div class="coloumn_details">
    <div class="table1"> <a style="text-decoration: none; color: inherit;" href="/dashboard_admin"> <i class="bi bi-arrow-left-circle-fill" style="margin-right: 10px;"></i>Back</a> </div>
   
  </div>
  <div class="coloumn_details">
    <div class="table1">Title</div>
    <div class="table2" ><%-data_article.title %></div>
  </div>
  <div class="coloumn_details">
    <div class="table1">Date</div>
    <div class="table2" ><%-data_article.date%></div>
  </div>
  <div class="coloumn_details">
    <div class="table1">Description</div>
    <div class="table2" ><%-data_article.description%></div>
  </div>
  <div class="coloumn_details">
    <div class="table1">Image</div>
    <div class="table2" ><a href="<%-data_article.image%>"><%-data_article.image%></a></div>
  </div>
  <div class="coloumn_details">
    <div class="table1">Author</div>
    <div class="table2" ><%-data_article.author%></div>
  </div>
  <div class="coloumn_details">
    <div class="table1">Url</div>
    <div class="table2" ><a href="/article/<%-data_article.slug%>"><%-data_article.slug%></a></div>
  </div>
  <div class="coloumn_details">
    <div class="table1">Status</div>
    <div class="table2" ><%-data_article.isPublished%></div>
  </div>

</section>


