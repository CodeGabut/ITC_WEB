      </nav>

    </div>


     <section>
     
        <div class="container container-form px-3" style="background-color: rgb(41, 41, 41); border-radius: 5px; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5) ;border: #003277 solid 5px ;">
          <form id="article-form" method="post"  enctype="multipart/form-data" action="<%= edit ? `/edit/${slug}`  : "/create_article" %>">

            <a href="/dashboard_admin" style="text-decoration: none;">
              <div  class="mt-2"> &lt; Back to Dashboard</div>
            </a>
            <div class="d-flex justify-content-center mt-4">
              <img src="/images/Logo_ITC.png" alt="" style="width: 150px;height: 100px;">
            </div>
            <h2 class="text-center m-5" style="border-bottom: #024bb1 2px solid;"> <%= edit ? "Edit Section" : "Create New Article - ITC MIPA UNSOED" %> </h2>
            <div class="form_resvonsipe" style="display: flex;height: fit-content;width: 100%;gap: 20px;">
              
              <div>
                <div class="mb-3">
                    <label for="title" class="form-label" style="font-weight: bold;">Article Title</label>
                    <input  value="<%= edit ? data_article.title : "" %>" name="title" type="text" class="form-control form-control-data form_container" id="title_input" placeholder="Enter article title" required>
                </div>
                <div class="mb-3">
                    <label for="title" class="form-label" style="font-weight: bold;">Author</label>
                    <input value="<%= edit ? data_article.author : "" %>" name="author" type="text" id="writer_input" class="form-control form-control-data form_container" placeholder="Enter your name" required>
                </div>
              </div>

               <div  style="flex-grow: 1;">
                <div class="mb-3">
                  
                  <label for="title" class="form-label" style="font-weight: bold;">Status</label>
    
                  <div class="d-flex gap-3">
                    <div class="form-check d-flex ">

            <div onclick="checked()">
              <input class="form-check-input-hide" type="checkbox" value="hiden" id="checkDefault" >
            </div>
            <label class="form-check-label mx-1" for="checkDefault"><i class="bi bi-eye-slash"></i> Hide </label>
                        </div>
                   
                 
                   
    
                  </div>
                </div>

               
            <div class="mb-3" 
              <label for="content" class="form-label" style="font-weight: bold;">Description</label>
              <textarea value="" name="description" id="description_input" class="form-control form-control-data " rows="2" placeholder="Write your description here..." style="box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5) ;" required><%= edit ? data_article.description : "" %></textarea>
          </div>

              </div>

              <div  >
                <div class="mb-3">
                  
                  <label for="title" class="form-label">Categories</label>
    
                  <div class="d-flex gap-3">
                    <div class="form-check">
  <input class="form-check-input" type="radio" name="categories" id="radio1" value="Event & Activities" <%= tags === 'Event & Activities' ? 'checked' : ''  %> required>
  <label class="form-check-label" for="radio1">
    Event & Activities
  </label>
</div>

<div class="form-check">
  <input class="form-check-input" type="radio" name="categories" id="radio2" value="Information & Tech" <%= tags === 'Information & Tech' ? 'checked' : ''  %>>
  <label class="form-check-label" for="radio2">
    Information & Tech
  </label>
</div>
<div class="form-check">
  <input class="form-check-input" type="radio" name="categories" id="radio3" value="Else" <%= tags === 'Else' ? 'checked' : ''  %>>
  <label class="form-check-label" for="radio2">
    Else
  </label>
</div>

                   
    
                  </div>
                </div>

                  <div class="mb-3" >
                <label for="thumbnail" class="form-label" >Thumbnail</label>
                <input style="box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5) ;"  name="image" type="file" id="thumbnail_input" class="form-control form-control-data " accept="image/*" <%= edit ? "" : "required" %>  >

                <%- edit ? " <p>Your prevoius images file is in the cloud <br> Click the button if you want to change it</p>" : "" %>
               
                
            </div>

              </div>

             
              

              
            </div>
            
      

         
            
           

            <label for="thumbnail" class="form-label">Content</label>
            <div id="toolbar" style="background-color: #ffff!important;">
              <button class="ql-bold"></button>
              <button class="ql-italic"></button>
              <button class="ql-underline"></button>
              <button class="ql-strike"></button>
              <button class="ql-blockquote"></button>
              <button class="ql-link"></button>
              <button class="ql-image"></button>
              <button class="ql-code-block"></button>
            </div>
            
         
            <div id="editor" style="background-color: #ffff; color: black;"></div>
            
            
             <input type="hidden" name="content" id="quill-content" required>
           
            <button class="btn btn-custom w-100 mb-3 publish mt-4" type="submit"  >Publish Article <i class="bi bi-upload"></i></button>

            
            <input value="" id="categories_input_hide" name="hide" type="text"   style="display: none;" >
            <% if (edit) { %>
              <input value="<%-image%>" name="image" type="text"  style="display: none;" >
            <% } %>
            
          </form>
       
    
  
    </section>



</section>


 <script src="js/preview.js"></script>

  <script>
      var quill = new Quill('#editor', {
  theme: 'snow',
  modules: {
    toolbar: '#toolbar'
  }
});



quill.clipboard.dangerouslyPasteHTML(`<%- edit ? data_article.content : ""%>`)



document.getElementById("article-form").onsubmit = function() {
  console.log("it'succes");
  document.getElementById("quill-content").value = quill.root.innerHTML;
};
    </script>

<script src="js/delete_method.js" >
</script>

<script >

  function checked() {
    console.log("tess");
    
    
    let categories_hide = document.getElementById('categories_input_hide') ; 
    let check_hide = document.querySelectorAll('.form-check-input-hide:checked') ; 
    const values_hide = Array.from(check_hide).map(checkbox => checkbox.value);
    categories_hide.value = values_hide
    
    
    
  }
  
</script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
  </body>
</html>