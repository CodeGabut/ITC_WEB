     <script>
   document.addEventListener('DOMContentLoaded', () => {
    const currentUrl = window.location.href;

    // WhatsApp
    const waMessage = "Kunjungi artikel menarik dari ITC dan informatif%0A";
    const waLink = `https://wa.me/?text=${encodeURIComponent(waMessage + currentUrl)}`;
    document.getElementById("wa-share-btn").href = waLink;

    // Facebook
    const fbLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
    document.getElementById("fb-share-btn").href = fbLink;

    // Copy Link
    document.getElementById("copy-link-btn").addEventListener("click", () => {
      navigator.clipboard.writeText(currentUrl)
    });
  });
</script>


