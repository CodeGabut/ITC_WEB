    </div>

  
<section class="container " >
  <h4>DASHBOARD ADMIN</h4>
  <p>Designed and built with all the love in the world by the Bootstrap team with the help of our contributors.</p>
    <input type="text" placeholder="Cari artikel..."> <button>Cari</button>


    <table class="table m-0" >
    <thead>
    <tr>
      <th scope="col " class="coloumn_isi">No</th>
      <th scope="col" class="coloumn_isi">Title</th>
      <th scope="col" class="coloumn_isi">Date</th>
      <th scope="col"class="coloumn_isi">Status</th>
      
        <th scope="col"class="coloumn_isi">

          <a href="/create_article" style="color: inherit; text-decoration: none;">

            <i class="bi bi-plus-circle-fill" style="font-size: 24px;"></i>

          </a>
        
        </th>
      
    </tr>
    </thead>
    <tbody >

      <% data_sliced.result.forEach((element,index) => { %>
        <tr>
      <th scope="row" class="isi"><%- index + data_sliced.number +1 %></th>
      <td class="isi"><%- element.title %></td>
      <td class="isi"><%- element.date.toLocaleDateString("id-ID", {
  day: 'numeric',
  month: 'numeric',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false 
})%></td>
      <td class="isi"><%- element.isPublished ? 'Publish' : 'Hiden' %></td>
       <td class="isi"><div class="dropdown">
  <a  href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="bi bi-gear-fill" style="color: rgb(126, 125, 125);"></i>
  </a>
  <ul class="dropdown-menu">
    <li><a class="dropdown-item" target="_blank" href="article/<%-element.slug%>"><i class="bi bi-link " style="margin-right: 5px !important;"></i>Visit</a></li>
    <li><a class="dropdown-item" href="#"><i class="bi bi-file-code " style="margin-right: 5px !important;"></i>Details</a></li>
    <li><a class="dropdown-item" href="/edit/<%-element.slug%>"><i class="bi bi-pencil " style="margin-right: 5px !important;"></i>Edit</a></li>
    <li>
  <a class="dropdown-item" href="/hiden/<%= element.slug %>">
    <%- !element.isPublished ? '<i class="bi bi-eye" style="margin-right: 5px !important;"></i> Publish': '<i class="bi bi-eye-slash" style="margin-right: 5px !important;"></i> Hide' %>
  </a></li>

    <li><a class="dropdown-item"  onclick="delete_('<%- element.slug %>')" ><i class="bi bi-trash " style="margin-right: 5px !important;"></i>Delete</a></li>
  </ul>
</div>

</td>
    </tr>
      <% }) %>
   
   
    
  </div>
</tbody>
</table>

<div class="footer_table">

<div class="data_table">
  <div>Total article : 20</div>
  <div>Storage : 20 Mb</div>
  <div> Max storage : 20 Mb</div>
</div>


<% if (data_sliced.prev) { %>
  <a style="text-decoration: none; color: inherit;" href="http://localhost:3000/dashboard_admin?page=<%-(parseInt(page)-1)%>"  >
  <div class="footer_font">&lt;</div>
  </a>
<% } %>



<% if (page > 3 ) { %>
   <a href="http://localhost:3000/dashboard_admin?page=1" style="text-decoration: none;color: inherit;">
    <div class="footer_font <% if (Math.ceil(data_length/2) == page) { %>
     <%- "number_currentPage" %>
    <% } %>">1 %></div>
  </a>
    <div class="footer_font">...</div>
 
<% } %>

<% for( let index = 0; index < 3; index++ ) { %>
  <a href="http://localhost:3000/dashboard_admin?page=<%-pagination[index]%>" style="text-decoration: none;color: inherit;">
    <div class="footer_font <% if (pagination[index] == page) { %>
     <%- "number_currentPage" %>
    <% } %>"><%- pagination[index] %></div>
  </a>
<% } %>

<% if (page < Math.ceil(data_length/8)-2 ) { %>
  <div class="footer_font">...</div>
  <a href="http://localhost:3000/dashboard_admin?page=<%-Math.ceil(data_length/8)%>" style="text-decoration: none;color: inherit;">
    <div class="footer_font <% if (Math.ceil(data_length/8) == page) { %>
     <%- "number_currentPage" %>
    <% } %>"><%- Math.ceil(data_length/8) %></div>
  </a>
<% } %>

<% if (data_sliced.next) { %>
  <a style="text-decoration: none; color: inherit;" href="http://localhost:3000/dashboard_admin?page=<%-(parseInt(page)+1)%>"  >
    <div class="footer_font">></div>
  </div>
  </a>
<% } %>


</section>

<script src="js/delete_method.js" >
</script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
  </body>
</html>