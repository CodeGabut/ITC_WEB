<div>
  <section class="container ">
    
    <% if (page == 1) { %>
     <div class="mb-3 mx-2" style="font-size: 32px;font-weight: bold;color: #00265c;">Informasi Terbaru</div>
     <div id="carouselExampleCaptions" class="carousel slide mx-2">
  
       <div class="carousel-indicators">
         <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"  style="margin:0;width: clamp(2px,1.5vw,10px);height: clamp(2px,1.5vw,10px);margin-left: 10px;"></button>
         <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2" style="margin:0;width: clamp(2px,1.5vw,10px);height: clamp(2px,1.5vw,10px);  margin-left: 10px;"></button>
         <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3" style="margin:0;width: clamp(2px,1.5vw,10px);height: clamp(2px,1.5vw,10px); margin-left: 10px;"></button>
       </div>
       <div class="carousel-inner">

     
  
         <div class="carousel-item active" href="">
          <a href="/article/<%-data_sliced.result[0].slug%>">
            <div style="width: 100%;aspect-ratio: 16/9;background: linear-gradient(to bottom, #032b63, #000f24);;overflow: hidden;">
              <img src="<%- data_sliced.result[0].image %>" alt="" style="width: 100%;aspect-ratio: 16/9; object-fit: cover; z-index: 2; opacity: 25%; ">
            </div>
            <div class="carousel-caption" style="text-align: left;" >
              <h5 style="font-size: clamp(12px,3vw,36px) ;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin-bottom: clamp(0px,0.5vw,8px);"><%- data_sliced.result[0].title %></h5>
              <p style="font-size: clamp(8px,2vw,16px); color: #fffeff;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin: 0;"><%- cutDescription(data_sliced.result[0].description) %></p>
              <p style="font-size: clamp(8px,2vw,16px); color: #fffeff;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin-top: 8px;"><span><i class="bi bi-clock mx-2"></i></span><%- data_sliced.result[0].date.toLocaleDateString("id-ID", {
   day: 'numeric',
   month: 'long',
   year: 'numeric'
   }); %></p>
            </div>
          </a>
         </div>

         <div class="carousel-item ">

          <a href="/article/<%-data_sliced.result[1].slug%>">
            <div style="width: 100%;aspect-ratio: 16/9;background: linear-gradient(to bottom, #032b63, #000f24);;overflow: hidden;">
              <img src="<%- data_sliced.result[1].image %>" alt="" style="width: 100%;aspect-ratio: 16/9; object-fit: cover; z-index: 2; opacity: 25%; ">
            </div>
            <div class="carousel-caption" style="text-align: left;" >
              <h5 style="font-size: clamp(12px,3vw,36px) ;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin-bottom: clamp(0px,0.5vw,8px);"><%- data_sliced.result[1].title %></h5>
              <p style="font-size: clamp(8px,2vw,16px); color: #fffeff;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin: 0;"><%- cutDescription( data_sliced.result[1].description) %></p>
              <p style="font-size: clamp(8px,2vw,16px); color: #fffeff;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin-top: 8px;"><span><i class="bi bi-clock mx-2"></i></span><%- data_sliced.result[1].date.toLocaleDateString("id-ID", {
   day: 'numeric',
   month: 'long',
   year: 'numeric'
   }); %></p>
            </div>

          </a>
         </div>

         

         <div class="carousel-item ">
          <a href="/article/<%-data_sliced.result[2].slug%>">
            <div style="width: 100%;aspect-ratio: 16/9;background: linear-gradient(to bottom, #032b63, #000f24);;overflow: hidden;">
              <img src="<%- data_sliced.result[2].image %>" alt="" style="width: 100%;aspect-ratio: 16/9; object-fit: cover; z-index: 2; opacity: 25%; ">
            </div>
            <div class="carousel-caption" style="text-align: left;" >
              <h5 style="font-size: clamp(12px,3vw,36px) ;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin-bottom: clamp(0px,0.5vw,8px);"><%- data_sliced.result[2].title %></h5>
              <p style="font-size: clamp(8px,2vw,16px); color: #fffeff;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin: 0;"><%- cutDescription( data_sliced.result[2].description) %></p>
              <p style="font-size: clamp(8px,2vw,16px); color: #fffeff;text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);margin-top: 8px;"><span><i class="bi bi-clock mx-2"></i></span><%- data_sliced.result[2].date.toLocaleDateString("id-ID", {
   day: 'numeric',
   month: 'long',
   year: 'numeric'
   }); %></p>
            </div>

          </a>
         </div>
       </div>
       <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
         <span class="carousel-control-prev-icon" aria-hidden="true"></span>
         <span class="visually-hidden">Previous</span>
       </button>
  
       <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
         <span class="carousel-control-next-icon" aria-hidden="true"></span>
         <span class="visually-hidden">Next</span>
       </button>
     </div>
   <% } %>
  
   
  
   <div class="mb-3 mx-2" style="font-size: 32px;font-weight: bold;color: #00265c;">
    Lainnya..
  </div>
  
   <div class="row row-cols-1 row-cols-md-2 g-4 " style="margin-left: 1px;margin-right: 1px;">
  
     <% data_sliced.result.forEach((element,index) => { %>
      <% if (element.isPublished) { %>
          <a href="/article/<%-element.slug%>" style="text-decoration: none; color: inherit;">
         <div class="col article_hover" style="cursor: pointer; ">
           <div class="card margin_mobile_article" style="border: #00265c 1px solid;box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.3) !important;">
             <div style="background-color: #0060e700; width: 100%;aspect-ratio: 16/9;overflow: hidden;">
               <img src="<%-element.image%>" class="card-img-top" alt="...">
             </div>
             <div class="card-body">
               <h5 class="card-title"><%- element.title %></h5>
               <p class="card-text"><%- cutDescription(element.description)%></p>
               <p class="card-text"> <i class="bi bi-clock"></i><span style="margin-left: 10px;"><%- element.date.toLocaleDateString("id-ID", {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
  }); %></span></p>
               <button type="button" class="btn btn-outline-primary" style="border: #00265c6c 1px solid; color: #ccc; background-color: #00265c;">Read More</button>
               <p class="tags" style="margin: 0;margin-top: 10px; color:#00265c">#<%- element.tags[0] %></p>
             </div>
             <div class="backround_hover <%-"article"+(index+1)%>" style="background-color: #00265c;width: 100%;height: 100%;position: absolute;z-index: -2; transition: 0.4s ease;border-radius: 5px;">
             </div>
           </div>
         </div>  
       </a>
      <% } %>
    
     <% }) %>
     </div>
  
   
     </div>
     
  <div class="page_section mt-5 mb-5" style="background-color: #cccccc00;width: 100%;height: 20px; display: flex; flex-direction: row; justify-content: center;">
  
  
  
    <% if (data_sliced.prev) { %>
     <a class="link_page" href="/blog?page=<%-parseInt(page)-1%>">
       <div class="page">&lt;</div>
     </a>
   <% } %>
  
   <% if (page >2) { %>
     <a class="link_page" href="/blog?page=1">
       <div class="page ">1</div>
     </a>
     <div class="page">...</div>
   <% } %>
  
  
   <% for( let index = 0; index < 3; index++ ) { %>
  
     <a href="/blog?page=<%-data_pagination[index]%>" class="link_page">
       <div class="page <% if (data_pagination[index] == page) { %>
        <%- "current_page" %>
       <% } %>"><%- data_pagination[index] %></div>
     </a>
   <% } %>
  
   <% if (page < totalPages-2) { %>
     <div class="page ">...</div>
     <a class="link_page" href="/blog?page=<%-totalPages%>">
       <div class="page "><%- totalPages %></div>
     </a>
   <% } %>
  
   <% if (data_sliced.next) { %>
  
     <a class="link_page"  href="/blog?page=<%-parseInt(page)+1%>">
      <div class="page">></div>
     </a>
    
   <% } %>
  
  
  </div>
  
  
  
  </section>

</div>


